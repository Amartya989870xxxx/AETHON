# Storage. SQLite by default; point at PostGIS/Timescale for production.
# DATABASE_URL=postgresql+psycopg://platetrail:pass@localhost:5432/platetrail

# --- Component 1: recognition thresholds ---
ANPR_MIN_ALERT_CONF=0.80     # below this a read is stored but cannot alert
ANPR_MIN_STORE_CONF=0.35     # below this the system abstains entirely
ANPR_FUSION_WINDOW=7         # frames fused per vehicle pass
ANPR_MAX_REPAIRS=2           # max characters the format validator may correct

# --- Component 2: trajectory matching ---
TRAJ_MIN_SPEED=4             # km/h, slowest plausible urban crawl
TRAJ_MAX_SPEED=110           # km/h, fastest plausible urban transit
TRAJ_MAX_SKIPS=2             # cameras a hop may bridge over
TRAJ_FUZZY_ED=1              # edit distance for recovering misread plates

# --- Component 3: analytics ---
ANALYTICS_BUCKET_S=300       # aggregation bucket width
ANALYTICS_FREE_FLOW=50       # km/h reference for the speed-drop term
ANALYTICS_Z_THRESHOLD=1.5    # sigma above a segment's own baseline = congested

# --- Component 4: alerts ---
ALERT_DEDUPE_S=900           # cooldown before the same alert repeats
ALERT_FUZZY_MIN_CONF=0.88    # confidence floor for a fuzzy watch-list match
ALERT_IMPOSSIBLE_SPEED=130   # km/h implying a cloned plate

# --- Privacy ---
FRAME_RETENTION_S=3600       # raw imagery lifetime; structured events outlive it
